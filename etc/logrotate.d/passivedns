# SIGHUP reopens these paths. create makes the new inode before the signal.
# If the daemon drops privileges, change the owner to that user and group.
# With -T, the log path has to exist inside the chroot.
/var/log/passivedns.log /var/log/passivedns-nx.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root root
    postrotate
        /bin/kill -HUP `pgrep passivedns 2>/dev/null` 2>/dev/null || true
    endscript
    su root syslog
}

