# copytruncate keeps the inode the daemon already holds. A new root-owned
# file cannot be reopened after -u, and a path outside -T cannot be
# reopened at all. A few lines can be lost between the copy and the truncate.
/var/log/passivedns.log /var/log/passivedns-nx.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su root syslog
}

